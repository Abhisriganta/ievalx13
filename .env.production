# ── iEvalX Frontend — PRODUCTION ──────────────────────────────────────────────
# Auto-loaded by `vite build`. All VITE_* values are PUBLIC (baked into the
# browser bundle) — never put secrets here.

# Backend API gateway (Envoy via Cloudflare). Same-origin, so no CORS.
VITE_API_BASE_URL=https://ievalx.com/api

# Weekly / real-time interview service. Leave as the site origin so the app
# derives wss://ievalx.com/weekly_interview/... automatically.
VITE_WEEKLY_INTERVIEW_URL=https://ievalx.com

# App metadata + feature flags
VITE_APP_NAME=IEvalx
VITE_FEATURE_AI_INTERVIEW=true
VITE_FEATURE_ASSESSMENTS=true
VITE_FEATURE_CANDIDATE_POOL=true
