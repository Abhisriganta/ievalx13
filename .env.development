# ── iEvalX Frontend — LOCAL DEVELOPMENT ───────────────────────────────────────
# Auto-loaded by `vite` (npm run dev). Relative /api is forwarded to the dev
# backend by the proxy in vite.config.js — so you don't hit prod from local.

VITE_API_BASE_URL=/api
VITE_WEEKLY_INTERVIEW_URL=
VITE_APP_NAME=IEvalx (dev)
VITE_FEATURE_AI_INTERVIEW=true
VITE_FEATURE_ASSESSMENTS=true
VITE_FEATURE_CANDIDATE_POOL=true
